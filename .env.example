# Google OAuth client and authorized-user token; keep both outside this repository.
GOOGLE_OAUTH_CLIENT_PATH=/absolute/path/to/google-client.json
GOOGLE_OAUTH_TOKEN_PATH=/absolute/path/to/google-token.json

# The Karina-compatible financial planner spreadsheet to manage.
GOOGLE_SHEET_FINANCIAL_PLANNER_ID=

# OAuth scopes must include Google Drive and Google Calendar for their capabilities.
# Tavily Search API key for employment, freelance, and investing-news search.
TAVILY_API_KEY=

# Durable mutation actions default to ~/.local/state/agent-workspace/actions.db.
# AGENT_WORKSPACE_STATE_DIR=/absolute/path/to/state

# Uploads are limited to this workspace by default. Use colon-separated absolute paths to extend it.
# AGENT_WORKSPACE_UPLOAD_DIRS=/absolute/path/to/allowed/uploads
